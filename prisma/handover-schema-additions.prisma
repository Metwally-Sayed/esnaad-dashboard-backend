// Add these enums to your schema.prisma file

enum HandoverStatus {
  DRAFT
  SENT_TO_OWNER
  OWNER_CONFIRMED
  CHANGES_REQUESTED
  ADMIN_CONFIRMED
  COMPLETED
  CANCELLED
}

enum HandoverItemStatus {
  OK
  NOT_OK
  NA
}

enum DocumentModule {
  HANDOVER
  UNIT_PROFILE
  SNAGGING
  PROJECT
}

enum DocumentType {
  PDF
  DOCX
  XLSX
}

