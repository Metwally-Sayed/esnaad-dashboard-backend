generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OWNER
}

enum OtpPurpose {
  REGISTRATION
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

enum AuditAction {
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  UNIT_CREATED
  UNIT_UPDATED
  UNIT_DELETED
  UNIT_ASSIGNED
  UNIT_UNASSIGNED
  OWNER_CHANGED
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_DELETED
  SNAGGING_CREATED
  SNAGGING_UPDATED
  SNAGGING_DELETED
  SNAGGING_STATUS_CHANGED
  SNAGGING_MESSAGE_CREATED
  SNAGGING_MESSAGE_UPDATED
  SNAGGING_MESSAGE_DELETED
  HANDOVER_CREATED
  HANDOVER_UPDATED
  HANDOVER_SENT_TO_OWNER
  HANDOVER_OWNER_CONFIRMED
  HANDOVER_CHANGES_REQUESTED
  HANDOVER_ADMIN_CONFIRMED
  HANDOVER_COMPLETED
  HANDOVER_CANCELLED
  HANDOVER_PDF_GENERATED
  HANDOVER_MESSAGE_CREATED
  DOCUMENT_CREATED
  UNIT_DOCUMENT_UPLOADED
  UNIT_DOCUMENT_DELETED
}

enum DocumentCategory {
  CONTRACT
  BILL
  OTHER
}

enum SnaggingStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum SnaggingPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum HandoverStatus {
  DRAFT
  SENT_TO_OWNER
  OWNER_CONFIRMED
  CHANGES_REQUESTED
  ADMIN_CONFIRMED
  COMPLETED
  CANCELLED
}

enum HandoverItemStatus {
  OK
  NOT_OK
  NA
}

enum DocumentModule {
  HANDOVER
  UNIT_PROFILE
  SNAGGING
  PROJECT
}

enum DocumentType {
  PDF
  DOCX
  XLSX
}

// Main user model
model User {
  id            String    @id @default(cuid())
  email         String    @unique
  password      String
  name          String?
  phone         String?   // Phone number
  address       String?   @db.Text // Physical address
  nationalId    String?   @unique // National ID / Iqama number
  role          Role      @default(OWNER)
  emailVerified Boolean   @default(false)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  ownedUnits        Unit[]
  auditLogs         AuditLog[]
  otps              Otp[]
  createdSnaggings  Snagging[]
  snaggingMessages  SnaggingMessage[]
  handoversAsOwner  Handover[]        @relation("HandoverOwner")
  handoversAsAdmin  Handover[]        @relation("HandoverAdmin")
  handoverMessages  HandoverMessage[] @relation("HandoverMessages")
  createdDocuments  Document[]        @relation("DocumentCreator")
  uploadedUnitDocuments UnitDocument[] @relation("UnitDocumentUploader")

  @@index([email])
  @@index([role])
  @@index([nationalId])
  @@map("users")
}

// Projects model
model Project {
  id          String    @id @default(cuid())
  name        String
  description String?   @db.Text
  location    String?
  startDate   DateTime?
  endDate     DateTime?
  status      String    @default("active") // active, completed, on-hold
  imageUrl    String?

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  units       Unit[]

  @@index([name])
  @@index([status])
  @@map("projects")
}

// Units model
model Unit {
  id           String   @id @default(cuid())
  unitNumber   String   @unique
  buildingName String?
  floor        Int?
  area         Float?
  bedrooms     Int?
  bathrooms    Int?
  description  String?  @db.Text
  imageUrls    String[] @default([])
  documentUrls String[] @default([])
  address      String?
  amenities    String?
  unitType     String?

  ownerId      String?
  projectId    String?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  owner        User?      @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  project      Project?   @relation(fields: [projectId], references: [id])
  auditLogs    AuditLog[]
  snaggings    Snagging[]
  handovers    Handover[]
  documents    UnitDocument[]

  @@index([unitNumber])
  @@index([ownerId])
  @@index([projectId])
  @@map("units")
}

// External clients model
model ExternalClient {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  company   String?
  verified  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@map("external_clients")
}

// OTP model
model Otp {
  id          String     @id @default(cuid())
  userId      String
  hashedOtp   String
  purpose     OtpPurpose
  expiresAt   DateTime
  verified    Boolean    @default(false)
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  resendCount Int        @default(0)
  maxResends  Int        @default(3)
  lastResent  DateTime?

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, verified])
  @@index([expiresAt])
  @@map("otps")
}

// Audit log model
model AuditLog {
  id         String      @id @default(cuid())
  action     AuditAction
  entityType String
  entityId   String
  actorId    String
  unitId     String?
  changes    Json?
  metadata   Json?
  ipAddress  String?
  userAgent  String?

  createdAt  DateTime    @default(now())

  // Relations
  actor      User        @relation(fields: [actorId], references: [id], onDelete: Cascade)
  unit       Unit?       @relation(fields: [unitId], references: [id])

  @@index([action])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

// Snagging model
model Snagging {
  id              String           @id @default(cuid())
  unitId          String
  createdByUserId String
  title           String
  description     String           @db.Text
  status          SnaggingStatus   @default(OPEN)
  priority        SnaggingPriority @default(MEDIUM)
  deletedAt       DateTime?

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  // Relations
  unit            Unit             @relation(fields: [unitId], references: [id], onDelete: Cascade)
  createdBy       User             @relation(fields: [createdByUserId], references: [id], onDelete: Cascade)
  messages        SnaggingMessage[]

  @@index([unitId, createdAt])
  @@index([createdByUserId, createdAt])
  @@index([status, priority])
  @@index([deletedAt])
  @@map("snaggings")
}

// Snagging message model
model SnaggingMessage {
  id           String    @id @default(cuid())
  snaggingId   String
  authorUserId String
  authorRole   Role
  bodyTitle    String?
  bodyText     String    @db.Text
  deletedAt    DateTime?

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  // Relations
  snagging     Snagging  @relation(fields: [snaggingId], references: [id], onDelete: Cascade)
  author       User      @relation(fields: [authorUserId], references: [id], onDelete: Cascade)
  attachments  SnaggingAttachment[]

  @@index([snaggingId, createdAt])
  @@index([authorUserId])
  @@index([deletedAt])
  @@map("snagging_messages")
}

// Snagging attachment model
model SnaggingAttachment {
  id        String   @id @default(cuid())
  messageId String
  url       String
  fileName  String
  mimeType  String
  sizeBytes Int

  createdAt DateTime @default(now())

  // Relations
  message   SnaggingMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId])
  @@map("snagging_attachments")
}

// Handover model - represents the unit handover workflow
model Handover {
  id                String           @id @default(cuid())
  unitId            String
  ownerId           String           // The owner receiving the handover
  createdByAdminId  String           // Admin who created the handover
  status            HandoverStatus   @default(DRAFT)
  version           Int              @default(1)

  // Dates
  scheduledAt       DateTime?        // Optional scheduled handover date
  handoverAt        DateTime?        // Actual handover date/time
  ownerConfirmedAt  DateTime?
  adminConfirmedAt  DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?

  // Content
  notes             String?          @db.Text // Public notes visible to owner
  internalNotes     String?          @db.Text // Admin-only internal notes
  snapshotJson      Json?            // Frozen snapshot for PDF generation

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  // Relations
  unit              Unit             @relation(fields: [unitId], references: [id])
  owner             User             @relation("HandoverOwner", fields: [ownerId], references: [id])
  createdByAdmin    User             @relation("HandoverAdmin", fields: [createdByAdminId], references: [id])
  items             HandoverItem[]
  attachments       HandoverAttachment[]
  messages          HandoverMessage[]
  documents         Document[]       @relation("HandoverDocuments")

  @@index([unitId, createdAt])
  @@index([ownerId, createdAt])
  @@index([status, createdAt])
  @@index([createdByAdminId])
  @@map("handovers")
}

// Handover checklist items
model HandoverItem {
  id             String              @id @default(cuid())
  handoverId     String
  category       String              // e.g., "Electrical", "Plumbing", "General"
  label          String              // e.g., "All lights working"
  expectedValue  String?             // Optional expected value
  actualValue    String?             // Actual observed value
  status         HandoverItemStatus  @default(NA)
  notes          String?             @db.Text
  sortOrder      Int                 @default(0)

  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  // Relations
  handover       Handover            @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  attachments    HandoverAttachment[] @relation("ItemAttachments")

  @@index([handoverId, sortOrder])
  @@map("handover_items")
}

// Handover attachments (photos, documents)
model HandoverAttachment {
  id          String        @id @default(cuid())
  handoverId  String
  itemId      String?       // Optional link to specific checklist item
  url         String        // Cloudflare R2 URL
  key         String        // R2 object key
  mimeType    String
  sizeBytes   Int
  caption     String?

  createdAt   DateTime      @default(now())

  // Relations
  handover    Handover      @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  item        HandoverItem? @relation("ItemAttachments", fields: [itemId], references: [id], onDelete: SetNull)

  @@index([handoverId])
  @@index([itemId])
  @@map("handover_attachments")
}

// Handover messages (comment thread)
model HandoverMessage {
  id           String    @id @default(cuid())
  handoverId   String
  authorUserId String
  authorRole   Role
  body         String    @db.Text

  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  // Relations
  handover     Handover  @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  author       User      @relation("HandoverMessages", fields: [authorUserId], references: [id])

  @@index([handoverId, createdAt])
  @@index([authorUserId])
  @@index([deletedAt])
  @@map("handover_messages")
}

// Shared Documents module
model Document {
  id               String         @id @default(cuid())
  module           DocumentModule
  entityId         String         // e.g., handoverId
  type             DocumentType
  templateKey      String         // e.g., "handover-agreement-v1"
  version          Int            @default(1)

  // File details
  url              String         // Cloudflare R2 URL
  key              String         // R2 object key
  sha256Hash       String         // SHA-256 hash of the file
  sizeBytes        Int

  // Metadata
  title            String?
  description      String?
  metadata         Json?          // Additional metadata

  createdByUserId  String
  createdAt        DateTime       @default(now())

  // Relations
  createdBy        User           @relation("DocumentCreator", fields: [createdByUserId], references: [id])
  handover         Handover?      @relation("HandoverDocuments", fields: [entityId], references: [id], onDelete: Cascade)

  @@index([module, entityId, createdAt])
  @@index([createdByUserId])
  @@index([templateKey])
  @@map("documents")
}

// Unit Documents model - for contracts, bills, and other PDF documents
model UnitDocument {
  id               String           @id @default(cuid())
  unitId           String
  title            String
  category         DocumentCategory
  fileKey          String           // R2 object key
  mimeType         String           // Must be application/pdf
  sizeBytes        Int
  uploadedByUserId String

  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  // Relations
  unit             Unit             @relation(fields: [unitId], references: [id], onDelete: Cascade)
  uploadedBy       User             @relation("UnitDocumentUploader", fields: [uploadedByUserId], references: [id])

  @@index([unitId, createdAt])
  @@index([category])
  @@index([uploadedByUserId])
  @@map("unit_documents")
}