generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  OWNER
}

enum OwnerVerificationStatus {
  NOT_REQUIRED      // For ADMIN users (skip verification)
  PENDING_DOCUMENTS // Owner needs to upload passport/ID
  PENDING_APPROVAL  // Documents uploaded, waiting for admin
  APPROVED          // Admin approved, can access dashboard
  REJECTED          // Admin rejected, must re-upload
}

enum OwnerDocumentType {
  PASSPORT
  NATIONAL_ID
}

enum DocumentApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OtpPurpose {
  REGISTRATION
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

enum AuditAction {
  USER_CREATED
  USER_UPDATED
  USER_DELETED
  UNIT_CREATED
  UNIT_UPDATED
  UNIT_DELETED
  UNIT_ASSIGNED
  UNIT_UNASSIGNED
  OWNER_CHANGED
  PROJECT_CREATED
  PROJECT_UPDATED
  PROJECT_DELETED
  SNAGGING_CREATED
  SNAGGING_UPDATED
  SNAGGING_DELETED
  SNAGGING_STATUS_CHANGED
  SNAGGING_SENT_TO_OWNER
  SNAGGING_ACCEPTED
  SNAGGING_CANCELLED
  SNAGGING_APPOINTMENT_SET
  SNAGGING_PDF_GENERATED
  SNAGGING_MESSAGE_CREATED
  SNAGGING_MESSAGE_UPDATED
  SNAGGING_MESSAGE_DELETED
  HANDOVER_CREATED
  HANDOVER_UPDATED
  HANDOVER_SENT_TO_OWNER
  HANDOVER_ACCEPTED
  HANDOVER_OWNER_CONFIRMED
  HANDOVER_CHANGES_REQUESTED
  HANDOVER_ADMIN_CONFIRMED
  HANDOVER_COMPLETED
  HANDOVER_CANCELLED
  HANDOVER_PDF_GENERATED
  HANDOVER_MESSAGE_CREATED
  DOCUMENT_CREATED
  UNIT_DOCUMENT_UPLOADED
  UNIT_DOCUMENT_DELETED
  REQUEST_CREATED
  REQUEST_APPROVED
  REQUEST_REJECTED
  REQUEST_CANCELLED
  REQUEST_REVOKED
  REQUEST_MESSAGE_CREATED
  REQUEST_MESSAGE_DELETED
  OWNER_DOCUMENT_UPLOADED
  OWNER_DOCUMENT_DELETED
  OWNER_DOCUMENT_APPROVED
  OWNER_DOCUMENT_REJECTED
  OWNER_VERIFICATION_APPROVED
  OWNER_VERIFICATION_REJECTED
  SERVICE_CHARGE_CREATED
  SERVICE_CHARGE_UPDATED
  SERVICE_CHARGE_DELETED
  UNIT_SERVICE_CHARGE_OVERRIDDEN
  SERVICE_CHARGE_STATEMENT_GENERATED
}

enum DocumentCategory {
  CONTRACT
  BILL
  OTHER
}

enum SnaggingStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  DRAFT
  SENT_TO_OWNER
  ACCEPTED
  CANCELLED
}

enum SnaggingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum HandoverStatus {
  DRAFT
  SENT_TO_OWNER
  ACCEPTED
  OWNER_CONFIRMED
  CHANGES_REQUESTED
  ADMIN_CONFIRMED
  COMPLETED
  CANCELLED
}

enum HandoverItemStatus {
  OK
  NOT_OK
  NA
}

enum DocumentModule {
  HANDOVER
  UNIT_PROFILE
  SNAGGING
  PROJECT
  REQUEST
}

enum DocumentType {
  PDF
  DOCX
  XLSX
}

// Main user model
model User {
  id                 String                   @id @default(cuid())
  email              String                   @unique
  password           String
  name               String?
  phone              String? // Phone number
  address            String?                  @db.Text // Physical address
  nationalId         String?                  @unique // National ID / Iqama number
  role               Role                     @default(OWNER)
  emailVerified      Boolean                  @default(false)
  isActive           Boolean                  @default(true)
  verificationStatus OwnerVerificationStatus  @default(PENDING_DOCUMENTS)
  verificationNote   String? // Admin rejection reason
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  // Relations
  ownedUnits            Unit[]
  auditLogs             AuditLog[]
  otps                  Otp[]
  createdSnaggings      Snagging[]        @relation("SnaggingCreatedBy")
  snaggingsAsOwner      Snagging[]        @relation("SnaggingOwner")
  handoversAsOwner      Handover[]        @relation("HandoverOwner")
  handoversAsAdmin      Handover[]        @relation("HandoverAdmin")
  handoverMessages      HandoverMessage[] @relation("HandoverMessages")
  createdDocuments      Document[]        @relation("DocumentCreator")
  uploadedUnitDocuments UnitDocument[]    @relation("UnitDocumentUploader")
  requestsAsOwner          Request[]                @relation("RequestOwner")
  incomingTransfers        Request[]                @relation("TransferToOwner")
  approvedRequests         Request[]                @relation("RequestApprovedBy")
  rejectedRequests         Request[]                @relation("RequestRejectedBy")
  requestMessages          RequestMessage[]         @relation("RequestMessages")
  ownerDocuments           OwnerDocument[]          @relation("OwnerDocuments")
  reviewedDocuments        OwnerDocument[]          @relation("DocumentReviewer")
  createdServiceCharges    ProjectServiceCharge[]   @relation("ServiceChargeCreator")
  overriddenServiceCharges UnitServiceCharge[]      @relation("ServiceChargeOverrider")

  @@index([email])
  @@index([role])
  @@index([nationalId])
  @@index([verificationStatus])
  @@map("users")
}

// Projects model
model Project {
  id          String    @id @default(cuid())
  name        String
  description String?   @db.Text
  location    String?
  startDate   DateTime?
  endDate     DateTime?
  status      String    @default("active") // active, completed, on-hold
  imageUrl    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  units          Unit[]
  serviceCharges ProjectServiceCharge[]

  @@index([name])
  @@index([status])
  @@map("projects")
}

// Units model
model Unit {
  id           String   @id @default(cuid())
  unitNumber   String   @unique
  buildingName String?
  floor        Int?
  area         Float?
  bedrooms     Int?
  bathrooms    Int?
  description  String?  @db.Text
  imageUrls    String[] @default([])
  documentUrls String[] @default([])
  address      String?
  amenities    String?
  unitType     String?
  price        Decimal?       @db.Decimal(12, 2) // Unit price for service charge calculation

  ownerId   String?
  projectId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  owner          User?                @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  project        Project?             @relation(fields: [projectId], references: [id])
  auditLogs      AuditLog[]
  snaggings      Snagging[]
  handovers      Handover[]
  documents      UnitDocument[]
  requests       Request[]
  serviceCharges UnitServiceCharge[]

  @@index([unitNumber])
  @@index([ownerId])
  @@index([projectId])
  @@map("units")
}

// External clients model
model ExternalClient {
  id       String  @id @default(cuid())
  email    String  @unique
  name     String?
  company  String?
  verified Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@map("external_clients")
}

// OTP model
model Otp {
  id          String     @id @default(cuid())
  userId      String
  hashedOtp   String
  purpose     OtpPurpose
  expiresAt   DateTime
  verified    Boolean    @default(false)
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  resendCount Int        @default(0)
  maxResends  Int        @default(3)
  lastResent  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose, verified])
  @@index([expiresAt])
  @@map("otps")
}

// Audit log model
model AuditLog {
  id         String      @id @default(cuid())
  action     AuditAction
  entityType String
  entityId   String
  actorId    String
  unitId     String?
  changes    Json?
  metadata   Json?
  ipAddress  String?
  userAgent  String?

  createdAt DateTime @default(now())

  // Relations
  actor User  @relation(fields: [actorId], references: [id], onDelete: Cascade)
  unit  Unit? @relation(fields: [unitId], references: [id])

  @@index([action])
  @@index([entityType, entityId])
  @@index([actorId])
  @@index([createdAt])
  @@map("audit_logs")
}

// Snagging model
model Snagging {
  id               String         @id @default(cuid())
  unitId           String
  ownerId          String // Owner user ID
  createdByAdminId String // Admin who created
  title            String
  description      String         @db.Text
  notes            String?        @db.Text // Admin internal notes
  status           SnaggingStatus @default(DRAFT)
  scheduledAt      DateTime? // Appointment date/time set by owner
  scheduledNote    String? // Note about appointment
  acceptedAt       DateTime? // When owner accepted
  pdfUrl           String? // Cloudinary secure_url for PDF
  pdfPublicId      String? // Cloudinary public_id

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  unit           Unit           @relation(fields: [unitId], references: [id], onDelete: Cascade)
  owner          User           @relation("SnaggingOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  createdByAdmin User           @relation("SnaggingCreatedBy", fields: [createdByAdminId], references: [id], onDelete: Cascade)
  items          SnaggingItem[]

  @@index([unitId, createdAt])
  @@index([ownerId, createdAt])
  @@index([status])
  @@map("snaggings")
}

// Snagging checklist items
model SnaggingItem {
  id         String           @id @default(cuid())
  snaggingId String
  category   String // "Electrical", "Plumbing", etc.
  label      String // Issue description
  location   String // "Master Bedroom", etc.
  severity   SnaggingSeverity @default(MEDIUM)
  notes      String?
  sortOrder  Int              @default(0)
  createdAt  DateTime         @default(now())

  // Relations
  snagging Snagging            @relation(fields: [snaggingId], references: [id], onDelete: Cascade)
  images   SnaggingItemImage[]

  @@index([snaggingId, sortOrder])
  @@map("snagging_items")
}

// Snagging item images
model SnaggingItemImage {
  id             String   @id @default(cuid())
  snaggingItemId String
  imageUrl       String // Cloudinary secure_url
  publicId       String // Cloudinary public_id
  caption        String?
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())

  // Relations
  snaggingItem SnaggingItem @relation(fields: [snaggingItemId], references: [id], onDelete: Cascade)

  @@index([snaggingItemId, sortOrder])
  @@map("snagging_item_images")
}

// Handover model - represents the unit handover workflow
model Handover {
  id               String         @id @default(cuid())
  unitId           String // ONE active handover per unit (enforced by partial unique index in migration)
  ownerId          String // The owner receiving the handover
  createdByAdminId String // Admin who created the handover
  status           HandoverStatus @default(DRAFT)
  version          Int            @default(1)

  // Dates
  scheduledAt      DateTime? // Optional scheduled handover date
  handoverAt       DateTime? // Actual handover date/time
  ownerAcceptedAt  DateTime? // When owner accepted (new simplified flow)
  ownerConfirmedAt DateTime?
  adminConfirmedAt DateTime?
  completedAt      DateTime?
  cancelledAt      DateTime?

  // PDF and signatures
  pdfUrl         String? // Final PDF URL (generated on acceptance)
  pdfPublicId    String? // R2/Cloudinary public ID
  adminSignature String? // Admin name (from DB)
  ownerSignature String? // Owner name (from DB)

  // Content
  notes         String? @db.Text // Public notes visible to owner
  internalNotes String? @db.Text // Admin-only internal notes
  snapshotJson  Json? // Frozen snapshot for PDF generation

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  unit           Unit                 @relation(fields: [unitId], references: [id])
  owner          User                 @relation("HandoverOwner", fields: [ownerId], references: [id])
  createdByAdmin User                 @relation("HandoverAdmin", fields: [createdByAdminId], references: [id])
  items          HandoverItem[]
  attachments    HandoverAttachment[]
  messages       HandoverMessage[]
  documents      Document[]           @relation("HandoverDocuments")

  @@index([unitId, createdAt])
  @@index([ownerId, createdAt])
  @@index([status, createdAt])
  @@index([createdByAdminId])
  @@map("handovers")
}

// Handover checklist items
model HandoverItem {
  id            String             @id @default(cuid())
  handoverId    String
  category      String // e.g., "Electrical", "Plumbing", "General"
  label         String // e.g., "All lights working"
  expectedValue String? // Optional expected value
  actualValue   String? // Actual observed value
  status        HandoverItemStatus @default(NA)
  notes         String?            @db.Text
  sortOrder     Int                @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  handover    Handover             @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  attachments HandoverAttachment[] @relation("ItemAttachments")

  @@index([handoverId, sortOrder])
  @@map("handover_items")
}

// Handover attachments (photos, documents)
model HandoverAttachment {
  id         String  @id @default(cuid())
  handoverId String
  itemId     String? // Optional link to specific checklist item
  url        String // Cloudflare R2 URL
  key        String // R2 object key
  mimeType   String
  sizeBytes  Int
  caption    String?

  createdAt DateTime @default(now())

  // Relations
  handover Handover      @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  item     HandoverItem? @relation("ItemAttachments", fields: [itemId], references: [id], onDelete: SetNull)

  @@index([handoverId])
  @@index([itemId])
  @@map("handover_attachments")
}

// Handover messages (comment thread)
model HandoverMessage {
  id           String @id @default(cuid())
  handoverId   String
  authorUserId String
  authorRole   Role
  body         String @db.Text

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  // Relations
  handover Handover @relation(fields: [handoverId], references: [id], onDelete: Cascade)
  author   User     @relation("HandoverMessages", fields: [authorUserId], references: [id])

  @@index([handoverId, createdAt])
  @@index([authorUserId])
  @@index([deletedAt])
  @@map("handover_messages")
}

// Shared Documents module
model Document {
  id          String         @id @default(cuid())
  module      DocumentModule
  entityId    String // e.g., handoverId
  type        DocumentType
  templateKey String // e.g., "handover-agreement-v1"
  version     Int            @default(1)

  // File details
  url        String // Cloudflare R2 URL
  key        String // R2 object key
  sha256Hash String // SHA-256 hash of the file
  sizeBytes  Int

  // Metadata
  title       String?
  description String?
  metadata    Json? // Additional metadata

  createdByUserId String
  createdAt       DateTime @default(now())

  // Relations
  createdBy User      @relation("DocumentCreator", fields: [createdByUserId], references: [id])
  handover  Handover? @relation("HandoverDocuments", fields: [entityId], references: [id], onDelete: Cascade)

  @@index([module, entityId, createdAt])
  @@index([createdByUserId])
  @@index([templateKey])
  @@map("documents")
}

// Unit Documents model - for contracts, bills, and other PDF documents
model UnitDocument {
  id               String           @id @default(cuid())
  unitId           String
  title            String
  category         DocumentCategory
  fileKey          String // R2 object key
  mimeType         String // Must be application/pdf
  sizeBytes        Int
  uploadedByUserId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  unit       Unit @relation(fields: [unitId], references: [id], onDelete: Cascade)
  uploadedBy User @relation("UnitDocumentUploader", fields: [uploadedByUserId], references: [id])

  @@index([unitId, createdAt])
  @@index([category])
  @@index([uploadedByUserId])
  @@map("unit_documents")
}

// Owner Documents for verification (passport, national ID)
model OwnerDocument {
  id                String                 @id @default(cuid())
  userId            String
  type              OwnerDocumentType
  fileKey           String // Cloudinary URL
  mimeType          String
  sizeBytes         Int
  status            DocumentApprovalStatus @default(PENDING)
  rejectionReason   String?
  reviewedByAdminId String?
  reviewedAt        DateTime?
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  // Relations
  user            User  @relation("OwnerDocuments", fields: [userId], references: [id], onDelete: Cascade)
  reviewedByAdmin User? @relation("DocumentReviewer", fields: [reviewedByAdminId], references: [id])

  @@index([userId])
  @@index([status])
  @@map("owner_documents")
}

// Request enums
enum RequestType {
  GUEST_VISIT
  WORK_PERMISSION
  OWNERSHIP_TRANSFER
  TENANT_REGISTRATION
  UNIT_MODIFICATIONS
}

enum RequestStatus {
  SUBMITTED
  APPROVED
  REJECTED
  EXPIRED
  CANCELLED
}

enum ExpiresMode {
  DATE
  USES
  UNLIMITED
}

enum ServiceChargePeriodType {
  YEARLY
  QUARTERLY
}

// Requests / Invitations model
model Request {
  id      String        @id @default(cuid())
  unitId  String
  ownerId String
  type    RequestType
  status  RequestStatus @default(SUBMITTED)
  purpose String?       @db.Text

  // Visitor/Work info
  visitorName        String?
  visitorPhone       String?
  companyName        String?
  representativeName String?

  // Ownership Transfer info
  transferUnitIds String[] @default([])
  newOwnerId      String?
  newOwnerName    String?
  newOwnerEmail   String?
  newOwnerPhone   String?
  message         String?  @db.Text

  // Tenant Registration info
  tenantName      String?
  tenantEmail     String?
  tenantPhone     String?
  emiratesIdUrl   String?  // R2/Cloudinary URL for Emirates ID document
  passportUrl     String?  // R2/Cloudinary URL for passport document
  rentContractUrl String?  // R2/Cloudinary URL for rent contract PDF
  ijaryUrl        String?  // R2/Cloudinary URL for Ijary PDF

  // Unit Modifications info
  modificationType      String?  // Predefined type: RENOVATION, REPAIR, ADDITION, etc.
  modificationTypeOther String?  // Custom type when 'OTHER' is selected
  modificationMessage   String?  @db.Text  // Description of the modification
  contactEmail          String?  // Contact email (pre-filled from owner, editable)
  contactPhone          String?  // Contact phone (pre-filled from owner, editable)

  // Schedule
  startAt DateTime?
  endAt   DateTime?

  // Expiry configuration (set on approval)
  expiresMode ExpiresMode?
  expiresAt   DateTime?
  maxUses     Int?         @default(0)
  usesCount   Int          @default(0)

  // Approval/Rejection
  approvedByAdminId String?
  approvedAt        DateTime?
  rejectedByAdminId String?
  rejectedAt        DateTime?
  rejectionReason   String?   @db.Text

  // PDF
  pdfUrl      String?
  pdfPublicId String?

  // Meta
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Relations
  unit            Unit             @relation(fields: [unitId], references: [id], onDelete: Cascade)
  owner           User             @relation("RequestOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  newOwner        User?            @relation("TransferToOwner", fields: [newOwnerId], references: [id], onDelete: SetNull)
  approvedByAdmin User?            @relation("RequestApprovedBy", fields: [approvedByAdminId], references: [id], onDelete: SetNull)
  rejectedByAdmin User?            @relation("RequestRejectedBy", fields: [rejectedByAdminId], references: [id], onDelete: SetNull)
  messages        RequestMessage[]

  @@index([ownerId, createdAt])
  @@index([unitId, createdAt])
  @@index([status])
  @@index([type])
  @@index([deletedAt])
  @@map("requests")
}

// Request Messages - for communication between admin and owner on unit modification requests
model RequestMessage {
  id           String    @id @default(cuid())
  requestId    String
  authorUserId String
  authorRole   Role
  body         String    @db.Text
  createdAt    DateTime  @default(now())
  deletedAt    DateTime?

  request Request @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author  User    @relation("RequestMessages", fields: [authorUserId], references: [id])

  @@index([requestId, createdAt])
  @@index([authorUserId])
  @@index([deletedAt])
  @@map("request_messages")
}

// Project Service Charge - default service charge for a project
model ProjectServiceCharge {
  id              String                  @id @default(cuid())
  projectId       String
  year            Int                     // e.g., 2024
  quarter         Int?                    // 1-4 for quarterly, null for yearly
  periodType      ServiceChargePeriodType
  percentage      Decimal                 @db.Decimal(5, 2)  // e.g., 5.00 = 5%
  dueDate         DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  createdById     String

  project         Project                 @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy       User                    @relation("ServiceChargeCreator", fields: [createdById], references: [id])
  unitCharges     UnitServiceCharge[]

  @@unique([projectId, year, quarter])
  @@index([projectId])
  @@index([year])
  @@map("project_service_charges")
}

// Unit Service Charge - individual unit service charges with optional override
model UnitServiceCharge {
  id                      String                @id @default(cuid())
  unitId                  String
  projectServiceChargeId  String

  // Calculated or overridden amount
  amount                  Decimal               @db.Decimal(12, 2)
  isOverridden            Boolean               @default(false)
  overriddenAmount        Decimal?              @db.Decimal(12, 2)
  overriddenById          String?
  overriddenAt            DateTime?

  // PDF Statement
  pdfUrl                  String?               // Cloudinary URL for statement
  pdfGeneratedAt          DateTime?

  // Status
  isPaid                  Boolean               @default(false)
  paidAt                  DateTime?

  createdAt               DateTime              @default(now())
  updatedAt               DateTime              @updatedAt

  unit                    Unit                  @relation(fields: [unitId], references: [id], onDelete: Cascade)
  projectServiceCharge    ProjectServiceCharge  @relation(fields: [projectServiceChargeId], references: [id], onDelete: Cascade)
  overriddenBy            User?                 @relation("ServiceChargeOverrider", fields: [overriddenById], references: [id])

  @@unique([unitId, projectServiceChargeId])
  @@index([unitId])
  @@index([projectServiceChargeId])
  @@map("unit_service_charges")
}
