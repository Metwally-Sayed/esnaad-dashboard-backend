# Spacefile for Deta Space deployment
v: 0
micros:
  - name: esnaad-backend
    src: .
    engine: nodejs18
    primary: true
    run: npm run start
    build_commands:
      - npm install
      - npm run build
      - npm run prisma:generate
    presets:
      env:
        - name: NODE_ENV
          default: production
        - name: PORT
          default: "8080"
    public_routes:
      - "/*"
    memory: 512