<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Unit Handover Agreement</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Arial', sans-serif;
            line-height: 1.6;
            color: #333;
            background: white;
        }

        .container {
            max-width: 800px;
            margin: 0 auto;
            padding: 20px;
        }

        .header {
            text-align: center;
            margin-bottom: 40px;
            padding-bottom: 20px;
            border-bottom: 3px solid #2563eb;
        }

        .header h1 {
            color: #1e40af;
            font-size: 28px;
            margin-bottom: 10px;
        }

        .header .subtitle {
            color: #64748b;
            font-size: 14px;
        }

        .section {
            margin-bottom: 30px;
        }

        .section-title {
            background: #f1f5f9;
            padding: 10px 15px;
            margin-bottom: 15px;
            border-left: 4px solid #2563eb;
            font-size: 18px;
            font-weight: bold;
            color: #1e40af;
        }

        .info-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
            margin-bottom: 15px;
        }

        .info-item {
            padding: 10px;
            background: #fafafa;
            border-radius: 4px;
        }

        .info-item.full-width {
            grid-column: 1 / -1;
        }

        .info-label {
            font-weight: bold;
            color: #64748b;
            font-size: 12px;
            text-transform: uppercase;
            margin-bottom: 5px;
        }

        .info-value {
            color: #1e293b;
            font-size: 14px;
        }

        .checklist-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
        }

        .checklist-table th {
            background: #e2e8f0;
            padding: 10px;
            text-align: left;
            font-size: 14px;
            color: #475569;
            border-bottom: 2px solid #cbd5e1;
        }

        .checklist-table td {
            padding: 10px;
            border-bottom: 1px solid #e2e8f0;
            font-size: 14px;
        }

        .checklist-table tr:hover {
            background: #f8fafc;
        }

        .status-badge {
            display: inline-block;
            padding: 3px 8px;
            border-radius: 4px;
            font-size: 12px;
            font-weight: bold;
        }

        .status-ok {
            background: #dcfce7;
            color: #166534;
        }

        .status-not-ok {
            background: #fee2e2;
            color: #991b1b;
        }

        .status-na {
            background: #f3f4f6;
            color: #6b7280;
        }

        .attachments-list {
            list-style: none;
            padding: 0;
        }

        .attachments-list li {
            padding: 8px;
            background: #fafafa;
            margin-bottom: 5px;
            border-radius: 4px;
            font-size: 14px;
        }

        .signature-section {
            margin-top: 50px;
            padding-top: 30px;
            border-top: 2px solid #e2e8f0;
        }

        .signature-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 40px;
            margin-top: 30px;
        }

        .signature-box {
            text-align: center;
        }

        .signature-line {
            border-top: 2px solid #cbd5e1;
            margin-top: 60px;
            padding-top: 10px;
        }

        .signature-label {
            font-weight: bold;
            color: #475569;
            font-size: 14px;
        }

        .signature-name {
            color: #1e293b;
            font-size: 16px;
            margin-top: 5px;
        }

        .signature-image {
            max-width: 200px;
            max-height: 80px;
            margin-bottom: 10px;
            border-bottom: 1px solid #e2e8f0;
        }

        .signature-timestamp {
            font-size: 11px;
            color: #94a3b8;
            margin-top: 5px;
        }

        .footer {
            margin-top: 50px;
            padding-top: 20px;
            border-top: 1px solid #e2e8f0;
            text-align: center;
            font-size: 12px;
            color: #94a3b8;
        }

        .notes {
            background: #fffbeb;
            border: 1px solid #fbbf24;
            border-radius: 4px;
            padding: 15px;
            margin-top: 15px;
        }

        .notes-title {
            font-weight: bold;
            color: #92400e;
            margin-bottom: 5px;
        }

        .page-break {
            page-break-after: always;
        }

        @media print {
            body {
                font-size: 12pt;
            }

            .section {
                page-break-inside: avoid;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- Header -->
        <div class="header">
            <h1>UNIT HANDOVER AGREEMENT</h1>
            <div class="subtitle">
                Document ID: {{handover.id}}<br>
                Generated: {{formatDateTime generatedAt}}
            </div>
        </div>

        <!-- Unit Information -->
        <div class="section">
            <div class="section-title">Unit Information</div>
            <div class="info-grid">
                <div class="info-item">
                    <div class="info-label">Unit Number</div>
                    <div class="info-value">{{unit.unitNumber}}</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Building</div>
                    <div class="info-value">{{unit.buildingName}}</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Floor</div>
                    <div class="info-value">{{#if unit.floor}}{{unit.floor}}{{else}}N/A{{/if}}</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Unit Type</div>
                    <div class="info-value">{{#if unit.unitType}}{{unit.unitType}}{{else}}N/A{{/if}}</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Area (sqm)</div>
                    <div class="info-value">{{#if unit.area}}{{unit.area}}{{else}}N/A{{/if}}</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Bedrooms</div>
                    <div class="info-value">{{#if unit.bedrooms}}{{unit.bedrooms}}{{else}}N/A{{/if}}</div>
                </div>
                {{#if unit.address}}
                <div class="info-item full-width">
                    <div class="info-label">Address</div>
                    <div class="info-value">{{unit.address}}</div>
                </div>
                {{/if}}
                {{#if unit.project}}
                <div class="info-item full-width">
                    <div class="info-label">Project</div>
                    <div class="info-value">{{unit.project.name}}{{#if unit.project.location}} - {{unit.project.location}}{{/if}}</div>
                </div>
                {{/if}}
            </div>
        </div>

        <!-- Owner Information -->
        <div class="section">
            <div class="section-title">Owner Information</div>
            <div class="info-grid">
                <div class="info-item">
                    <div class="info-label">Name</div>
                    <div class="info-value">{{owner.name}}</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Email</div>
                    <div class="info-value">{{owner.email}}</div>
                </div>
                {{#if owner.phone}}
                <div class="info-item">
                    <div class="info-label">Phone</div>
                    <div class="info-value">{{owner.phone}}</div>
                </div>
                {{/if}}
                {{#if owner.nationalId}}
                <div class="info-item">
                    <div class="info-label">National ID / Iqama</div>
                    <div class="info-value">{{owner.nationalId}}</div>
                </div>
                {{/if}}
                {{#if owner.address}}
                <div class="info-item full-width">
                    <div class="info-label">Address</div>
                    <div class="info-value">{{owner.address}}</div>
                </div>
                {{/if}}
            </div>
        </div>

        <!-- Handover Details -->
        <div class="section">
            <div class="section-title">Handover Details</div>
            <div class="info-grid">
                <div class="info-item">
                    <div class="info-label">Handover Date</div>
                    <div class="info-value">{{#if handover.handoverAt}}{{formatDate handover.handoverAt}}{{else}}{{formatDate handover.createdAt}}{{/if}}</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Status</div>
                    <div class="info-value">{{handover.status}}</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Created By</div>
                    <div class="info-value">{{admin.name}}</div>
                </div>
                <div class="info-item">
                    <div class="info-label">Created Date</div>
                    <div class="info-value">{{formatDate handover.createdAt}}</div>
                </div>
            </div>

            {{#if handover.notes}}
            <div class="notes">
                <div class="notes-title">Notes:</div>
                <div>{{handover.notes}}</div>
            </div>
            {{/if}}
        </div>

        <!-- Checklist Items -->
        {{#if items}}
        <div class="section">
            <div class="section-title">Inspection Checklist</div>
            <table class="checklist-table">
                <thead>
                    <tr>
                        <th>Category</th>
                        <th>Item</th>
                        <th>Expected</th>
                        <th>Actual</th>
                        <th>Status</th>
                        <th>Notes</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each items}}
                    <tr>
                        <td>{{category}}</td>
                        <td>{{label}}</td>
                        <td>{{#if expectedValue}}{{expectedValue}}{{else}}-{{/if}}</td>
                        <td>{{#if actualValue}}{{actualValue}}{{else}}-{{/if}}</td>
                        <td>
                            <span class="status-badge status-{{#if (eq status 'OK')}}ok{{else if (eq status 'NOT_OK')}}not-ok{{else}}na{{/if}}">
                                {{status}}
                            </span>
                        </td>
                        <td>{{#if notes}}{{notes}}{{else}}-{{/if}}</td>
                    </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
        {{/if}}

        <!-- Attachments -->
        {{#if attachments}}
        <div class="section">
            <div class="section-title">Attachments</div>
            <ul class="attachments-list">
                {{#each attachments}}
                <li>
                    {{#if caption}}{{caption}}{{else}}Attachment {{@index}}{{/if}}
                    ({{mimeType}})
                </li>
                {{/each}}
            </ul>
        </div>
        {{/if}}

        <!-- Signature Section -->
        <div class="signature-section">
            <div class="section-title">Agreement & Signatures</div>

            <p style="margin: 20px 0; line-height: 1.8; text-align: justify;">
                By signing below, both parties acknowledge that they have inspected the unit described above
                and agree to the condition and terms as documented in this handover agreement. The Owner confirms
                receipt of the unit in the condition described in this document.
            </p>

            <div class="signature-grid">
                <div class="signature-box">
                    {{#if handover.ownerSignatureUrl}}
                    <img src="{{handover.ownerSignatureUrl}}" alt="Owner Signature" class="signature-image" />
                    {{/if}}
                    <div class="signature-line">
                        <div class="signature-label">Owner Signature</div>
                        <div class="signature-name">{{owner.name}}</div>
                        {{#if owner.nationalId}}
                        <div style="font-size: 12px; color: #94a3b8; margin-top: 5px;">
                            ID: {{owner.nationalId}}
                        </div>
                        {{/if}}
                        {{#if handover.ownerSignedAt}}
                        <div class="signature-timestamp">
                            Signed: {{formatDateTime handover.ownerSignedAt}}
                        </div>
                        {{/if}}
                    </div>
                </div>
                <div class="signature-box">
                    {{#if handover.adminSignatureUrl}}
                    <img src="{{handover.adminSignatureUrl}}" alt="Administrator Signature" class="signature-image" />
                    {{/if}}
                    <div class="signature-line">
                        <div class="signature-label">Administrator Signature</div>
                        <div class="signature-name">{{admin.name}}</div>
                        <div style="font-size: 12px; color: #94a3b8; margin-top: 5px;">
                            {{admin.email}}
                        </div>
                        {{#if handover.adminSignedAt}}
                        <div class="signature-timestamp">
                            Signed: {{formatDateTime handover.adminSignedAt}}
                        </div>
                        {{/if}}
                    </div>
                </div>
            </div>
        </div>

        <!-- Footer -->
        <div class="footer">
            <p>This is a legally binding document. Please keep a copy for your records.</p>
            <p>Generated by {{generatedBy.name}} ({{generatedBy.email}}) on {{formatDateTime generatedAt}}</p>
            <p>Document Hash: {{#if sha256Hash}}{{sha256Hash}}{{else}}[Will be calculated upon generation]{{/if}}</p>
        </div>
    </div>
</body>
</html>