<!DOCTYPE html>
<html>
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Snagging Report</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      line-height: 1.6;
      color: #333;
      background: #f5f5f5;
    }

    .container {
      max-width: 900px;
      margin: 0 auto;
      background: white;
      padding: 40px;
      box-shadow: 0 0 20px rgba(0, 0, 0, 0.1);
    }

    .header {
      border-bottom: 3px solid #2c3e50;
      padding-bottom: 20px;
      margin-bottom: 30px;
    }

    .header h1 {
      font-size: 32px;
      color: #2c3e50;
      margin-bottom: 10px;
    }

    .header .subtitle {
      font-size: 14px;
      color: #666;
    }

    .info-section {
      background: #f9fafb;
      padding: 20px;
      border-radius: 8px;
      margin-bottom: 30px;
      border-left: 4px solid #3498db;
    }

    .info-section h2 {
      font-size: 18px;
      color: #2c3e50;
      margin-bottom: 15px;
      text-transform: uppercase;
      letter-spacing: 1px;
      font-weight: 600;
    }

    .info-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 20px;
    }

    .info-row {
      display: flex;
      flex-direction: column;
    }

    .info-label {
      font-weight: 600;
      color: #2c3e50;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 5px;
    }

    .info-value {
      color: #555;
      font-size: 14px;
      line-height: 1.5;
    }

    .status-badge {
      display: inline-block;
      padding: 6px 12px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      background: #27ae60;
      color: white;
    }

    .status-badge.draft {
      background: #95a5a6;
    }

    .status-badge.sent {
      background: #3498db;
    }

    .status-badge.accepted {
      background: #27ae60;
    }

    .status-badge.cancelled {
      background: #e74c3c;
    }

    .items-section {
      margin-top: 40px;
    }

    .items-section h2 {
      font-size: 20px;
      color: #2c3e50;
      margin-bottom: 20px;
      padding-bottom: 10px;
      border-bottom: 2px solid #3498db;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .item-group {
      margin-bottom: 30px;
      page-break-inside: avoid;
    }

    .item-group-title {
      background: #34495e;
      color: white;
      padding: 12px 15px;
      border-radius: 4px 4px 0 0;
      font-weight: 600;
      font-size: 14px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .item-group-content {
      background: #f9fafb;
      border: 1px solid #e0e0e0;
      border-top: none;
      padding: 20px;
    }

    .item {
      margin-bottom: 25px;
      padding-bottom: 25px;
      border-bottom: 1px solid #e0e0e0;
      page-break-inside: avoid;
    }

    .item:last-child {
      margin-bottom: 0;
      padding-bottom: 0;
      border-bottom: none;
    }

    .item-header {
      display: flex;
      justify-content: space-between;
      align-items: start;
      margin-bottom: 12px;
    }

    .item-title {
      font-size: 16px;
      font-weight: 600;
      color: #2c3e50;
      flex: 1;
    }

    .item-severity {
      font-size: 12px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      padding: 4px 10px;
      border-radius: 12px;
      white-space: nowrap;
      margin-left: 10px;
    }

    .severity-critical {
      background: #e74c3c;
      color: white;
    }

    .severity-high {
      background: #e67e22;
      color: white;
    }

    .severity-medium {
      background: #f39c12;
      color: white;
    }

    .severity-low {
      background: #27ae60;
      color: white;
    }

    .item-details {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 15px;
      margin-bottom: 12px;
      font-size: 13px;
    }

    .item-detail {
      display: flex;
      flex-direction: column;
    }

    .detail-label {
      font-weight: 600;
      color: #555;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 3px;
    }

    .detail-value {
      color: #666;
      font-size: 13px;
    }

    .item-notes {
      background: #fffbea;
      border-left: 3px solid #f39c12;
      padding: 12px;
      margin-bottom: 12px;
      border-radius: 4px;
      font-size: 13px;
      color: #555;
      font-style: italic;
    }

    .item-images {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 10px;
      margin-top: 12px;
      page-break-inside: avoid;
    }

    .image-item {
      position: relative;
      overflow: hidden;
      border-radius: 4px;
      box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
      background: #e0e0e0;
    }

    .image-item img {
      width: 100%;
      height: 150px;
      object-fit: cover;
      display: block;
    }

    .image-caption {
      position: absolute;
      bottom: 0;
      left: 0;
      right: 0;
      background: rgba(0, 0, 0, 0.7);
      color: white;
      padding: 6px;
      font-size: 11px;
      text-align: center;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .footer-section {
      margin-top: 40px;
      padding-top: 20px;
      border-top: 2px solid #e0e0e0;
      font-size: 12px;
      color: #666;
    }

    .footer-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 30px;
      margin-bottom: 20px;
    }

    .footer-item h3 {
      font-size: 14px;
      font-weight: 600;
      color: #2c3e50;
      margin-bottom: 8px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .footer-item p {
      color: #666;
      line-height: 1.8;
    }

    .timestamp {
      text-align: center;
      margin-top: 30px;
      padding: 15px;
      background: #f5f5f5;
      border-radius: 4px;
      font-size: 12px;
      color: #666;
    }

    .signature-image {
      max-width: 200px;
      max-height: 80px;
      margin-bottom: 10px;
      border-bottom: 1px solid #e0e0e0;
    }

    .signature-timestamp {
      font-size: 11px;
      color: #999;
      margin-top: 5px;
    }

    .appointment-info {
      background: #e8f8f5;
      border-left: 4px solid #1abc9c;
      padding: 15px;
      margin-bottom: 20px;
      border-radius: 4px;
    }

    .appointment-info .label {
      font-weight: 600;
      color: #16a085;
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      margin-bottom: 5px;
    }

    .appointment-info .value {
      color: #27ae60;
      font-size: 14px;
    }

    @media print {
      body {
        background: white;
      }

      .container {
        box-shadow: none;
        padding: 0;
      }

      .page-break {
        page-break-after: always;
      }
    }

    @page {
      margin: 20mm;
      size: A4;
    }
  </style>
</head>
<body>
  <div class="container">
    <!-- Header Section -->
    <div class="header">
      <h1>Snagging Report</h1>
      <p class="subtitle">Unit Inspection and Issue Documentation</p>
    </div>

    <!-- Unit Information -->
    <div class="info-section">
      <h2>Unit Information</h2>
      <div class="info-grid">
        <div class="info-row">
          <span class="info-label">Unit Number</span>
          <span class="info-value">{{unit.unitNumber}}</span>
        </div>
        <div class="info-row">
          <span class="info-label">Building</span>
          <span class="info-value">{{unit.buildingName}}</span>
        </div>
        <div class="info-row">
          <span class="info-label">Floor</span>
          <span class="info-value">{{#if unit.floor}}{{unit.floor}}{{else}}N/A{{/if}}</span>
        </div>
        <div class="info-row">
          <span class="info-label">Area</span>
          <span class="info-value">{{#if unit.area}}{{unit.area}} sqm{{else}}N/A{{/if}}</span>
        </div>
      </div>
    </div>

    <!-- Report Metadata -->
    <div class="info-section">
      <h2>Report Details</h2>
      <div class="info-grid">
        <div class="info-row">
          <span class="info-label">Report Title</span>
          <span class="info-value">{{title}}</span>
        </div>
        <div class="info-row">
          <span class="info-label">Status</span>
          <span class="info-value">
            <span class="status-badge accepted">Accepted</span>
          </span>
        </div>
        <div class="info-row">
          <span class="info-label">Owner Name</span>
          <span class="info-value">{{ownerName}}</span>
        </div>
        <div class="info-row">
          <span class="info-label">Inspector Name</span>
          <span class="info-value">{{adminName}}</span>
        </div>
      </div>
    </div>

    <!-- Description -->
    {{#if description}}
    <div class="info-section">
      <h2>Report Description</h2>
      <p style="color: #555; line-height: 1.8;">{{description}}</p>
    </div>
    {{/if}}

    <!-- Appointment Information (if scheduled) -->
    {{#if scheduledAt}}
    <div class="appointment-info">
      <div class="label">Inspection Appointment</div>
      <div class="value">{{formatDate scheduledAt 'MMMM DD, YYYY [at] HH:mm'}}</div>
      {{#if scheduledNote}}<div style="margin-top: 8px; font-size: 13px; color: #555;">Note: {{scheduledNote}}</div>{{/if}}
    </div>
    {{/if}}

    <!-- Snagging Items -->
    <div class="items-section">
      <h2>Issues Found</h2>

      {{#each items}}
      {{#unless @first}}{{#if (shouldBreakCategory category ../prevCategory)}}<!-- Item group completed -->{{/if}}{{/unless}}

      {{#if (isFirstInCategory category ../prevCategory)}}
      <div class="item-group">
        <div class="item-group-title">{{category}}</div>
        <div class="item-group-content">
      {{/if}}

      <!-- Individual Item -->
      <div class="item">
        <div class="item-header">
          <span class="item-title">{{label}}</span>
          <span class="item-severity severity-{{toLowerCase severity}}">{{severity}}</span>
        </div>

        <div class="item-details">
          <div class="item-detail">
            <span class="detail-label">Location</span>
            <span class="detail-value">{{location}}</span>
          </div>
          <div class="item-detail">
            <span class="detail-label">Severity Level</span>
            <span class="detail-value">{{severity}}</span>
          </div>
        </div>

        {{#if notes}}
        <div class="item-notes">
          {{notes}}
        </div>
        {{/if}}

        {{#if images}}
        <div class="item-images">
          {{#each images}}
          <div class="image-item">
            <img src="{{imageUrl}}" alt="{{caption}}" />
            {{#if caption}}<div class="image-caption">{{caption}}</div>{{/if}}
          </div>
          {{/each}}
        </div>
        {{/if}}
      </div>

      {{#if (isLastInCategory category ../items ../prevCategory)}}
        </div>
      </div>
      {{/if}}

      {{/each}}
    </div>

    <!-- Footer Section -->
    <div class="footer-section">
      <div class="footer-grid">
        <div class="footer-item">
          <h3>Accepted By</h3>
          {{#if ownerSignatureUrl}}
          <img src="{{ownerSignatureUrl}}" alt="Owner Signature" class="signature-image" />
          {{/if}}
          <p>
            <strong>{{ownerName}}</strong><br>
            {{#if acceptedAt}}Accepted on: {{formatDate acceptedAt 'MMMM DD, YYYY [at] HH:mm'}}{{/if}}
            {{#if ownerSignedAt}}
            <span class="signature-timestamp"><br>Signed: {{formatDate ownerSignedAt 'MMMM DD, YYYY [at] HH:mm'}}</span>
            {{/if}}
          </p>
        </div>
        <div class="footer-item">
          <h3>Prepared By</h3>
          {{#if adminSignatureUrl}}
          <img src="{{adminSignatureUrl}}" alt="Administrator Signature" class="signature-image" />
          {{/if}}
          <p>
            <strong>{{adminName}}</strong><br>
            Inspector / Administrator
            {{#if adminSignedAt}}
            <span class="signature-timestamp"><br>Signed: {{formatDate adminSignedAt 'MMMM DD, YYYY [at] HH:mm'}}</span>
            {{/if}}
          </p>
        </div>
      </div>

      <div class="timestamp">
        Report Generated: {{formatDate createdAt 'MMMM DD, YYYY [at] HH:mm'}}<br>
        <small style="color: #999;">This is an official snagging report. Please retain for your records.</small>
      </div>
    </div>
  </div>
</body>
</html>
