# Environment
NODE_ENV=development
PORT=8080  # Changed to 8080 for claw.cloud compatibility

# Docker Registry Configuration (for deploy.sh)
DOCKER_REGISTRY=docker.io
DOCKER_USERNAME=your-dockerhub-username
IMAGE_NAME=esnaad-backend
IMAGE_TAG=latest

# Database (Neon.tech PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/esnaad_dashboard?schema=public"

# JWT Configuration (minimum 32 characters each)
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long-change-in-prod
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=your-refresh-secret-key-minimum-32-characters-long-change
JWT_REFRESH_EXPIRES_IN=30d

# OTP Configuration
OTP_EXPIRES_IN_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_MAX_RESENDS=3

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS
CORS_ORIGIN=*

# Email Configuration (SMTP) - Required for ownership transfer notifications
# See EMAIL_SERVICE_SETUP.md for detailed provider setup guides
#
# Gmail Example: Enable 2FA and create App Password at https://myaccount.google.com/apppasswords
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
#
# SendGrid Example (Recommended for production):
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASSWORD=SG.xxxxxxxxxxxxxxxxxxxx
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=your-email@gmail.com
SMTP_FROM_NAME=Esnaad Dashboard

# Frontend URL (Required for email links)
FRONTEND_URL=http://localhost:3000

# External Client Validation (optional)
# EXTERNAL_CLIENT_API_URL=https://api.example.com/clients
# EXTERNAL_CLIENT_API_KEY=your-api-key

# Cloudinary (Image uploads for snaggings)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Cloudflare R2 / AWS S3 (Document storage for handovers and PDFs)
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
R2_PUBLIC_URL=https://pub-xxxxxx.r2.dev
AWS_S3_BUCKET=esnaad-dashboard
